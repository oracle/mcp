FROM ghcr.io/oracle/oraclelinux:9-slim@sha256:1950389c3dd619841813520b4e69d7f3112c4c10f713fcb90680703d184c33ad

LABEL org.opencontainers.image.title="OCI Language MCP Server" \
      org.opencontainers.image.description="MCP server for OCI Language shared pretrained capabilities" \
      org.opencontainers.image.source="https://github.com/oracle/mcp/tree/main/src/oci-language-mcp-server" \
      org.opencontainers.image.licenses="UPL-1.0" \
      io.modelcontextprotocol.server.name="io.github.oracle/oci-language-mcp"

RUN microdnf install epel-release && \
  microdnf install python3.13 python3.13-pip \
  && rm -rf /var/cache/dnf/* \
  && useradd -m -d /app oracle

WORKDIR /app
COPY --chown=oracle:oracle . /app

RUN pip3.13 install --no-cache-dir uv && \
  uv --no-cache sync --no-sources --no-dev --no-editable

USER oracle

ENV LANGUAGE_MCP_HOST=127.0.0.1 \
    LANGUAGE_MCP_PORT=8080 \
    LANGUAGE_MCP_LOG_LEVEL=INFO \
    LANGUAGE_MCP_LOG_FORMAT=json \
    LANGUAGE_MCP_DEPLOYMENT_MODE=local \
    LANGUAGE_MCP_TRANSPORT=stdio \
    UV_NO_SYNC=1

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python3.13 -c "import os, urllib.request; transport=os.environ.get('LANGUAGE_MCP_TRANSPORT', 'stdio'); host=os.environ.get('LANGUAGE_MCP_HEALTHCHECK_HOST', 'localhost'); request=urllib.request.Request('http://127.0.0.1:'+os.environ.get('LANGUAGE_MCP_PORT', '8080')+'/health', headers={'Host': host}); exit(0) if transport == 'stdio' else urllib.request.urlopen(request, timeout=3)" || exit 1

ENTRYPOINT ["uv", "run", "oracle.oci-language-mcp-server"]
