{
  "name": "oci-javascript-mcp-server",
  "version": "0.1.0",
  "description": "Isolated OCI JavaScript code execution MCP server",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oci",
    "oracle",
    "cloud"
  ],
  "homepage": "https://github.com/oracle/mcp/tree/main/src/oci-javascript-mcp-server",
  "bugs": {
    "url": "https://github.com/oracle/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oracle/mcp.git",
    "directory": "src/oci-javascript-mcp-server"
  },
  "files": [
    "src/",
    "examples/",
    "docs/",
    "scripts/",
    ".dockerignore",
    "Containerfile",
    "Containerfile.host",
    "README.md",
    "LICENSE.txt"
  ],
  "bin": {
    "oci-javascript-mcp-server": "src/server.ts"
  },
  "scripts": {
    "start": "node --no-node-snapshot --experimental-strip-types src/server.ts",
    "podman:build": "podman build --pull -t localhost/oci-javascript-mcp-runner:dev .",
    "docker:build": "docker build --file Containerfile -t localhost/oci-javascript-mcp-runner:dev .",
    "docker:build-host": "docker build --file Containerfile.host -t localhost/oci-javascript-mcp-host:dev .",
    "oci:sync-kubernetes-secret": "python3 scripts/sync-oci-session-secret.py",
    "test": "node --no-node-snapshot --experimental-strip-types --test test/*.test.ts",
    "coverage": "c8 npm test",
    "check": "tsc --noEmit",
    "check:kubernetes-manifests": "node --no-node-snapshot --experimental-strip-types --test test/kata-manifests.test.ts test/kubernetes-manifests.test.ts",
    "check:kata-manifests": "npm run check:kubernetes-manifests",
    "kubectl:dry-run:kubernetes": "node --no-node-snapshot --experimental-strip-types scripts/kubectl-dry-run-kubernetes.ts",
    "packcheck": "npm --cache \"${TMPDIR:-/tmp}/oci-javascript-mcp-server-npm-cache\" pack --dry-run --json > /dev/null",
    "ci": "npm run coverage && npm run check && npm run packcheck",
    "prepublishOnly": "npm run ci"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "isolated-vm": "^7.0.0",
    "oci-common": "^2.132.0",
    "oci-sdk": "^2.132.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "typescript": "^5.9.3"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/sandbox-prelude.ts",
      "src/types.ts"
    ],
    "check-coverage": true,
    "statements": 90,
    "branches": 90,
    "functions": 90,
    "lines": 90,
    "reporter": [
      "text"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.12.1",
  "license": "UPL-1.0",
  "allowScripts": {
    "isolated-vm@7.0.0": true
  }
}
