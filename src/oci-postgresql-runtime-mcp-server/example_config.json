{
  "connections": {
    "app-db": {
      "host": "db.example.oraclecloud.com",
      "port": 5432,
      "database": "app_db",
      "user": "app_user",
      "sslmode": "verify-full",
      "sslrootcert": "/absolute/path/to/server-ca.pem",
      "password_keyring": {
        "service": "oracle-postgresql/app-db",
        "username": "app_user"
      }
    },
    "app-db-local-bastion": {
      "host": "db.example.oraclecloud.com",
      "hostaddr": "127.0.0.1",
      "port": 15432,
      "database": "app_db",
      "user": "app_user",
      "sslmode": "verify-full",
      "sslrootcert": "/absolute/path/to/server-ca.pem",
      "password_keyring": {
        "service": "oracle-postgresql/app-db-local-bastion",
        "username": "app_user"
      }
    }
  }
}
